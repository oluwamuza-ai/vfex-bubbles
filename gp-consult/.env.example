# Required for real consultations (server-side only)
ANTHROPIC_API_KEY=

# Models (defaults shown)
PATIENT_MODEL=claude-haiku-5-5
GRADER_MODEL=claude-opus-5-5

# Optional: single password gate for the whole app
APP_PASSWORD=

# Optional: SQLite file path (default ./data/gp.db)
DATABASE_PATH=./data/gp.db

# Set to 1 to use canned offline responses instead of the Anthropic API (for testing)
MOCK_LLM=0
